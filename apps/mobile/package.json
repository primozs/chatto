{
  "name": "@chatto/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check scripts/prepare.mjs && node --check scripts/prepare-web.mjs",
    "prepare-web": "node ./scripts/prepare-web.mjs",
    "generate:assets": "node ./scripts/generate-assets.mjs",
    "sync:ios": "node scripts/prepare.mjs && cap sync ios",
    "open:ios": "cap open ios",
    "build:ios": "xcodebuild -quiet -project ios/App/App.xcodeproj -scheme Chatto -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath ../../.context/mobile-ios-build CODE_SIGNING_ALLOWED=NO build",
    "sync:android": "pnpm run prepare-web && cap sync android",
    "build:apk": "pnpm run sync:android && node ./scripts/build-apk.mjs debug",
    "build:apk:release": "pnpm run sync:android && node ./scripts/build-apk.mjs release",
    "run:android": "pnpm run sync:android && cap run android --no-sync",
    "devices:android": "cap run android --list",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-file-picker": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "esbuild": "^0.27.7",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  }
}
